rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn() &&
             (userEmail() == 'machadovictorchaves@gmail.com' ||
              userEmail() == 'vyktorbio@gmail.com');
    }

    // Otimizado: usa apenas 1 chamada get() com fallback seguro .get('emails', []),
    // eliminando a chamada exists() duplicada que dobrava o custo de leitura das regras.
    function isRegisteredEmail() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/workspaces/agracta/config/usuarios_permitidos)
               .data.get('emails', []).hasAny([userEmail()]);
    }

    function isAuthorizedUser() {
      return isAdmin() || isRegisteredEmail();
    }

    match /workspaces/agracta {
      allow read: if isAuthorizedUser();
      // Permite que usuários autorizados atualizem o cabeçalho de revisão (rev/writeId)
      // durante transações de sincronização, evitando falhas e retentativas em loop.
      allow create, update: if isAuthorizedUser();
      allow delete: if isAdmin();

      // Coleção consolidada de Bundle JSON único (e partes caso passe de 700 KB)
      match /bundle/{partId} {
        allow read, write: if isAuthorizedUser();
      }

      // Sinalização auxiliar P2P (opcional)
      match /p2p_signal/{peerId} {
        allow read, write: if isAuthorizedUser();
      }

      // Demais coleções operacionais e de configuração
      match /{collectionName}/{docId} {
        allow read: if isAuthorizedUser();
        allow write, create, update, delete: if isAuthorizedUser() && collectionName != 'media';
      }
    }
  }
}
